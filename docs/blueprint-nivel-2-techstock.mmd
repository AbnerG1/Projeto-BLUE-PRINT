flowchart TB
  subgraph ACOES["Ações dos usuários"]
    direction LR
    A1["Abrir o Portal"] --> A2["Informar usuário e senha"] --> A3["Acessar o Banco"] --> A4["Consultar e pesquisar componentes"] --> A5["Preencher cadastro ou edição"] --> A6["Confirmar cadastro, atualização ou exclusão"]
  end
  subgraph FRONT["Frontstage — o que aparece"]
    direction LR
    F1["Portal: formulário de login"] --> F2["Banco: lista de componentes"] --> F3["Pesquisa e formulários de cadastro e edição"] --> F4["Confirmação de exclusão e mensagens"]
  end
  subgraph BACK["Backstage — o que acontece"]
    direction LR
    B1["Receber credenciais e autenticar"] --> B2["Criar e validar sessão"] --> B3["Verificar autenticação para abrir o Banco"] --> B4["Listar e pesquisar componentes"] --> B5["Validar dados do componente"] --> B6["Criar, atualizar ou excluir registro"] --> B7["Ler e gravar os dados"]
  end
  subgraph SUP["Suporte"]
    direction LR
    S1["Bottle e route.py: rotas HTTP"]
    S2["Application: coordenação"]
    S3["UserRecord e User_account: conta e autenticação"]
    S4["GerenciadorSessoes: controle da sessão"]
    S5["ComponentRecord e DataRecord: operações e persistência"]
    S6["Componente: modelo e validação"]
    S7["Arquivos JSON: contas e componentes"]
    S8["Views, HTML, CSS e JavaScript"]
  end
  A1 --> F1
  A2 --> B1
  F1 --> B1
